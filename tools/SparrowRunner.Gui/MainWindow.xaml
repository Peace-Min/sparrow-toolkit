<Window x:Class="SparrowRunner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SparrowRunner.Gui"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sparrow Helper"
        Width="1360" Height="860"
        MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Foreground="#191F28" ResizeMode="CanResize" WindowStyle="None"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0064FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#191F28"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5968"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8DDE3"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#C9D0D8"/>
        <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#E8F2FF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F4F6"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CodeSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#191F28"/>
        <SolidColorBrush x:Key="CodeSelectionBrush" Color="#B9D7FF"/>

        <!-- 상태 색상(매핑=성공/초록, 미매핑=경고/주황). 배지 배경/글자에 사용. -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#0F8A3C"/>
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#E7F6EC"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#B25E00"/>
        <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF2DE"/>
        <SolidColorBrush x:Key="ExcludedSourceBrush" Color="#E5484D"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 비활성이 색으로도 읽혀야 한다. 커스텀 템플릿이라 트리거가 없으면 disabled 가 enabled 와
                 똑같이 보여 "눌러도 아무 일 없는 버튼"이 된다(예: 도구 미탐색 상태의 실행 버튼). -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#20232A"/>
                    <Setter Property="BorderBrush" Value="#343842"/>
                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RuleCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 대분류(섹션) 탭은 하위 트랙 탭보다 크게 — 화면이 통째로 바뀌는 전환임을 시각적으로 알린다. -->
        <Style x:Key="SectionTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 범위 트리 한 줄. 로컬 소스 트리(Track A/B)와 xls 경로 트리(Track C)가 같은 노드 타입을 쓴다.
             Label = 이름(+ 검출 건수). AutomationId/Name 은 UIA 하네스가 노드를 이름으로 찾아 토글하기 위한 것. -->
        <HierarchicalDataTemplate x:Key="SelectableScopeTemplate" DataType="{x:Type local:SourceScopeNode}" ItemsSource="{Binding Children}">
            <CheckBox IsThreeState="{Binding HasChildren}"
                      AutomationProperties.AutomationId="scopeNodeCheck"
                      AutomationProperties.Name="{Binding Name}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Checked="ScopeCheckBox_Changed"
                      Unchecked="ScopeCheckBox_Changed"
                      Indeterminate="ScopeCheckBox_Changed"
                      Margin="0,2,0,2">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
        </HierarchicalDataTemplate>

        <!-- 프로젝트 탐색기는 실행 범위 선택기가 아니라 파일 탐색/미리보기 전용이다. -->
        <HierarchicalDataTemplate x:Key="ProjectScopeTemplate" DataType="{x:Type local:SourceScopeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Grid Width="26" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"
                      UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Image Width="22" Height="22" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/folder-closed-empty.png"/>
                                <Setter Property="ToolTip" Value="닫힌 빈 폴더"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/folder-closed-files.png"/>
                                        <Setter Property="ToolTip" Value="닫힌 폴더"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                            <Condition Binding="{Binding HasChildren}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/folder-open-empty.png"/>
                                        <Setter Property="ToolTip" Value="열린 빈 폴더"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                            <Condition Binding="{Binding HasChildren}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/folder-open-files.png"/>
                                        <Setter Property="ToolTip" Value="열린 폴더"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Width="24" Height="24" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceLanguage}" Value="C">
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/file-c.png"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="ToolTip" Value="C 소스 파일"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SourceLanguage}" Value="Cpp">
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/file-cpp.png"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="ToolTip" Value="C++ 소스 파일"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SourceLanguage}" Value="CSharp">
                                        <Setter Property="Source" Value="/SparrowRunner.Gui;component/Assets/file-csharp.png"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="ToolTip" Value="C# 소스 파일"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFile}" Value="True"/>
                                        <Condition Binding="{Binding IsChecked}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource ExcludedSourceBrush}"/>
                                    <Setter Property="ToolTip" Value="소스 파일 등록에서 선택 해제됨"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <!-- XLS 범위 트리 전용 항목 스타일(로컬 소스 트리는 위 기본 스타일 그대로 둔다).
             * AutomationProperties.Name: 명시하지 않으면 TreeViewItem 의 UIA 이름이 ToString() 폴백
               (= "SparrowRunner.Gui.SourceScopeNode") 으로 노출돼 스크린리더도 자동화도 노드를 못 읽는다.
               노드 표시명(이름 + 건수)을 그대로 이름으로 준다.
             * ToolTip: 실 규모에서는 이름이 길어 말줄임되므로 전체 경로(폴더=접두 경로, 파일=xls 원본 경로)를 띄운다.
             * HorizontalContentAlignment=Stretch: 행이 패널 폭을 채워야 TextTrimming 이 동작한다(가로 스크롤 대신 말줄임). -->
        <!-- 범위 트리(로컬 소스·XLS 경로 공용) 노드 스타일. AutomationProperties.Name 을 명시하지 않으면
             WPF 가 데이터 객체의 ToString() 으로 폴백해 UIA/스크린리더에 "SparrowRunner.Gui.SourceScopeNode"
             로 노출된다(실 xls 규모에서 발견). 두 트리 모두 SourceScopeNode 를 쓰므로 스타일을 공유한다. -->
        <Style x:Key="ScopeTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 마스터 목록(체커) 항목: 상용 설정앱풍 선택/호버 하이라이트. AutomationProperties.Name={Key} 로
             UIA 가 SelectionItemPattern 으로 행을 골라 선택할 수 있게 한다. -->
        <Style x:Key="MappingItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Key}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 사용자 제공 아이콘을 Windows 캡션 버튼 바로 왼쪽에 배치한 제목 표시줄. -->
        <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="▣" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Sparrow Helper" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <Button x:Name="ThemeButton" Grid.Column="2" Style="{StaticResource CaptionButtonStyle}"
                        Width="42" MinWidth="42" ToolTip="테마 선택" Click="ThemeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="ThemeButton">
                    <Rectangle Width="23" Height="23" Fill="{DynamicResource TextPrimaryBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/SparrowRunner.Gui;component/Assets/theme-title.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <Button x:Name="OpenLogWindowButton" Grid.Column="3" Style="{StaticResource CaptionButtonStyle}"
                        Width="42" MinWidth="42" ToolTip="실행 로그 열기" Click="OpenLogWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="OpenLogWindowButton">
                    <Rectangle Width="22" Height="22" Fill="{DynamicResource TextPrimaryBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/SparrowRunner.Gui;component/Assets/execution-log-title.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource CaptionButtonStyle}" Content="—" FontSize="13"
                        ToolTip="최소화" Click="MinimizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="5" Style="{StaticResource CaptionButtonStyle}" Content="□" FontSize="16"
                        ToolTip="최대화/복원" Click="MaximizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="6" Style="{StaticResource CloseCaptionButtonStyle}" Content="×" FontSize="20"
                        ToolTip="닫기" Click="CloseButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- 제목 표시줄 아래의 표준 메뉴 줄. -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource TitleBarBrush}">
        <Menu Background="Transparent" FontSize="13" AutomationProperties.AutomationId="MainMenu">
            <MenuItem x:Name="FileMenu" Header="파일(_F)" AutomationProperties.AutomationId="FileMenu">
                <MenuItem x:Name="OpenFileMenuItem" Header="파일 열기(_I)" InputGestureText="Ctrl+Alt+F"
                          ToolTip="코드 자동수정 대상 소스 파일, 솔루션 또는 프로젝트를 선택합니다."
                          AutomationProperties.AutomationId="OpenFileMenuItem"
                          Click="OpenFileMenuItem_Click"/>
                <MenuItem x:Name="OpenFolderMenuItem" Header="폴더 열기(_O)" InputGestureText="Ctrl+O"
                          ToolTip="코드 자동수정 대상 소스 폴더를 선택합니다."
                          AutomationProperties.AutomationId="OpenFolderMenuItem"
                          Click="OpenFolderMenuItem_Click"/>
                <MenuItem x:Name="ChooseOutputFolderMenuItem" Header="출력 폴더(_D)" InputGestureText="Ctrl+Shift+O"
                          ToolTip="XLS 분리 결과를 저장할 폴더를 선택합니다."
                          AutomationProperties.AutomationId="ChooseOutputFolderMenuItem"
                          Click="ChooseOutputFolderMenuItem_Click"/>
                <MenuItem x:Name="RegisterSourceMenuItem" Header="소스 파일 등록(_S)" InputGestureText="Ctrl+Shift+S"
                          ToolTip="코드 자동수정 대상 솔루션 또는 프로젝트를 등록합니다."
                          AutomationProperties.AutomationId="RegisterSourceMenuItem"
                          Click="RegisterSourceMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="OpenTargetFolderMenuItem" Header="대상 폴더 열기(_T)" InputGestureText="Ctrl+Alt+T"
                          AutomationProperties.AutomationId="OpenTargetFolderMenuItem"
                          Click="OpenTargetFolderMenuItem_Click"/>
                <MenuItem x:Name="OpenXlsOutputMenuItem" Header="출력 폴더 열기(_E)" InputGestureText="Ctrl+Alt+O"
                          AutomationProperties.AutomationId="OpenXlsOutputMenuItem"
                          Click="OpenXlsOutputMenuItem_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="종료(_X)" InputGestureText="Alt+F4"
                          AutomationProperties.AutomationId="ExitMenuItem"
                          Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="설정(_S)" AutomationProperties.AutomationId="SettingsMenu">
                <MenuItem Header="코드 규칙(_C)..." InputGestureText="Ctrl+Alt+C"
                          ToolTip="코드 자동수정 규칙을 선택하거나 해제합니다."
                          AutomationProperties.AutomationId="CodeRuleSettingsMenuItem"
                          Click="CodeRuleSettingsMenuItem_Click"/>
                <MenuItem Header="주석·레이아웃(_L)..." InputGestureText="Ctrl+Alt+L"
                          ToolTip="주석 및 레이아웃 규칙을 선택하거나 해제합니다."
                          AutomationProperties.AutomationId="CommentRuleSettingsMenuItem"
                          Click="CommentRuleSettingsMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="CommitPerRuleMenuItem" Header="규칙별 커밋 생성(_C)"
                          InputGestureText="Ctrl+Shift+C" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=CommitCheck, Mode=TwoWay}"
                          ToolTip="켜면 코드 자동수정 규칙마다 커밋을 생성합니다."
                          AutomationProperties.AutomationId="CommitPerRuleMenuItem"/>
                <Separator/>
                <MenuItem Header="체커 규칙 관리(_R)" InputGestureText="Ctrl+R"
                          AutomationProperties.AutomationId="ManageCheckerRulesMenuItem"
                          Click="ManageCheckerRulesMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="실행(_R)" AutomationProperties.AutomationId="ExecutionMenu">
                <MenuItem Header="실행(_R)" AutomationProperties.AutomationId="RunSubmenu">
                    <MenuItem x:Name="RunXlsMenuItem" Header="XLS 분리 실행(_X)" InputGestureText="F5"
                              AutomationProperties.AutomationId="RunXlsMenuItem"
                              Click="RunXlsMenuItem_Click"/>
                    <MenuItem x:Name="RunCodeRulesMenuItem" Header="코드 규칙 수정 실행(_R)" InputGestureText="F7"
                              AutomationProperties.AutomationId="RunCodeRulesMenuItem"
                              Click="RunCodeRulesMenuItem_Click"/>
                    <MenuItem x:Name="RunCommentLayoutMenuItem" Header="주석·레이아웃 수정 실행(_C)" InputGestureText="F6"
                              AutomationProperties.AutomationId="RunCommentLayoutMenuItem"
                              Click="RunCommentLayoutMenuItem_Click"/>
                </MenuItem>
                <MenuItem x:Name="StopXlsMenuItem" Header="중지(_S)" InputGestureText="Shift+F5"
                          ToolTip="현재 실행 중인 XLS 분리 또는 주석·레이아웃 수정을 중지합니다."
                          AutomationProperties.AutomationId="StopXlsMenuItem"
                          Click="StopXlsMenuItem_Click" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="도움말(_H)" AutomationProperties.AutomationId="HelpMenu">
                <MenuItem Header="도움말 보기(_V)" InputGestureText="F1"
                          AutomationProperties.AutomationId="ViewHelpMenuItem"
                          Click="ViewHelpMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="피드백 보내기(_F)" IsEnabled="False"
                          ToolTip="추후 지원 예정입니다."
                          AutomationProperties.AutomationId="SendFeedbackMenuItem"/>
                <Separator/>
                <MenuItem Header="프로그램 정보(_A)"
                          AutomationProperties.AutomationId="AboutMenuItem"
                          Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>
        </Grid>

        <Grid Margin="12,10,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== 대분류 3개 ===================== -->
        <!-- A. 코드 자동수정(내부 Track A/B) : C/C++와 C#을 상단 탭으로 구분해 소스 파일을 고친다. 커밋은 하지 않는다 —
                러너에 항상 -NoCommit 을 넘기고, 검토·커밋은 사용자가 git 으로 한다.
             B. XLS 분리(내부 Track C)       : 언어 무관 · 프로젝트 경로 불필요 · 읽기전용.
             둘은 입력도 위험도도 다르므로 같은 화면에 섞지 않는다.
             화면 명칭 ↔ 내부 트랙: [코드 규칙]=A · [주석·레이아웃]=B · [XLS 분리]=C (UI 에는 트랙 명칭을 쓰지 않는다). -->
        <TabControl x:Name="SectionTabs" AutomationProperties.AutomationId="SectionTabs"
                    Grid.Row="0" BorderThickness="0" Background="Transparent"
                    SelectionChanged="SectionTabs_SelectionChanged">

            <!-- ===================== A. 코드 자동수정 (C/C++) ===================== -->
            <TabItem x:Name="SectionFixTab" AutomationProperties.AutomationId="SectionFixTab"
                     Style="{StaticResource SectionTabItem}" Header="코드 자동수정 (C/C++)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 대상 선택 명령은 [파일] 메뉴로 모두 이관했다. 아래 컨트롤은 기존 명령 구현과
                         자동화 호환을 위한 숨김 프록시이며 화면 공간을 차지하지 않는다. -->
                    <Grid Grid.Row="0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="대상(.sln/.csproj/폴더)" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="TargetPathBox" AutomationProperties.AutomationId="TargetPathBox"
                                 Grid.Column="1" Style="{StaticResource InputBox}" TextChanged="TargetPathBox_TextChanged"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="BrowseFileButton" Grid.Column="2" Content="파일 선택" Margin="8,0,0,0" Click="BrowseFileButton_Click"/>
                        <Button x:Name="BrowseFolderButton" Grid.Column="3" Content="폴더 선택" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                        <Button x:Name="RefreshScopeButton" Grid.Column="4" Content="새로고침" Margin="8,0,0,0" Click="RefreshScopeButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ProjectExplorerToggle" Grid.Column="0" Content="▱"
                                                  Width="30" Height="28" Margin="0,0,8,0"
                                                  FontSize="18" IsChecked="True" Cursor="Hand"
                                                  ToolTip="프로젝트 트리 숨기기 또는 보이기"
                                                  AutomationProperties.AutomationId="ProjectExplorerToggle"
                                                  Checked="ProjectExplorerToggle_Changed"
                                                  Unchecked="ProjectExplorerToggle_Changed"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="프로젝트 탐색기" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock x:Name="ScopeStatusText" AutomationProperties.AutomationId="ScopeStatusText"
                                                   Text="폴더를 열면 소스 파일이 표시됩니다." Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 기존 전체/해제 명령은 테스트·내부 명령 호환을 위해 숨김 프록시로 유지한다. -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="SelectAllScopeButton" Content="전체" Click="SelectAllScopeButton_Click"/>
                                    <Button x:Name="ClearScopeButton" Content="해제" Click="ClearScopeButton_Click"/>
                                </StackPanel>
                                <Border x:Name="ProjectExplorerTreeHost" Grid.Row="2" Margin="0,10,0,0">
                                    <TreeView x:Name="ScopeTree" AutomationProperties.AutomationId="ScopeTree"
                                              ItemsSource="{Binding ScopeRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemTemplate="{StaticResource ProjectScopeTemplate}"
                                              ItemContainerStyle="{StaticResource ScopeTreeItemStyle}"
                                              SelectedItemChanged="ScopeTree_SelectedItemChanged"
                                              MouseDoubleClick="ScopeTree_MouseDoubleClick"
                                              BorderThickness="0" Background="Transparent"
                                              VirtualizingStackPanel.IsVirtualizing="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="210"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="0" Padding="14">
                                <TabControl x:Name="RulesTabs" AutomationProperties.AutomationId="RulesTabs"
                                            BorderThickness="0" Background="Transparent" SelectionChanged="RulesTabs_SelectionChanged">
                                    <TabItem x:Name="TrackATab" AutomationProperties.AutomationId="TrackATab" Header="코드 규칙">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="기본 자동수정" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="ASObjectVarSafe" Content="객체 생성 명시 타입을 var로 변경" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObviousVar" Content="명확한 지역변수 타입을 var로 변경" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASArrayVarSafe" Content="배열 초기화 문법 간소화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASParens" Content="논리식 괄호 명확화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                                <TextBlock Text="선택 자동수정" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="ASForeachCast" Content="[검토필요] foreach Cast&lt;T&gt; + var" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObjectInitializer" Content="연속 대입을 object initializer로 통합" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASNullVar" Content="[검토필요] typed null var 초기화" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObjectVarNarrowing" Content="[검토필요] 상위 타입 선언을 var로 축소" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASLocalConst" Content="[검토필요] 지역 const를 var로 변경" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASArrayVarNarrowing" Content="[검토필요] 배열 선언을 var + new[]로 축소" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASForVar" Content="for 초기화절 변수를 var로 변경" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASFieldSplit" Content="한 줄 다중 필드 선언 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASEmptyStmt" Content="잉여 빈문장 제거" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASForHoist" Content="[검토필요] for 다중 선언자 hoist 분해" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem x:Name="TrackBTab" AutomationProperties.AutomationId="TrackBTab" Header="주석·레이아웃">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="기본 주석 규칙" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="BTrailing" Content="코드 뒤 주석을 윗줄로 이동" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BSpace" Content="주석 기호 뒤 공백 추가" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BPeriod" Content="주석 끝 마침표 추가" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BCapitalize" Content="주석 첫 영문 대문자화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                                <TextBlock Text="선택 레이아웃/주석 규칙" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="BFlatten" Content="별표/Doxygen 블록 주석 평탄화" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BMemberBlank" Content="멤버 선언 사이 빈 줄 추가" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BOneDeclaration" Content="한 줄 다중 선언 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BOneStatement" Content="한 줄 다중 구문 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BContinuation" Content="여러 줄 문장 들여쓰기 보정" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BLinqAlign" Content="LINQ query 절 정렬" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BBlockPromote" Content="[검토필요] inline block 주석 이동" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                </TabControl>
                            </Border>

                            <Border Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="RuleInfoTitle" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="RuleInfoBody" Margin="0,4,0,8" Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="260" Margin="16,0,0,0">
                                            <TextBlock x:Name="SummaryTargetText" Text="대상 경로가 필요합니다."
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SummaryRulesText" Text="선택 규칙 0개"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="SummaryModeText" Text="파일만 수정 · 커밋하지 않음"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Before" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="RuleBeforeBox" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False"
                                                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap" Background="#0B1220" Foreground="#E5E7EB"
                                                     BorderBrush="#253044" Padding="10"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="After" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="RuleAfterBox" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False"
                                                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap" Background="#F8FAFF" Foreground="#191F28"
                                                     BorderBrush="#C9DDFF" Padding="10"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="{DynamicResource TitleBarBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TabControl x:Name="PinnedSourceTabs" BorderThickness="0" Background="Transparent"
                                                    SelectionChanged="PinnedSourceTabs_SelectionChanged" Padding="0" Margin="0">
                                            <TabControl.ItemContainerStyle>
                                                <Style TargetType="TabItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Padding" Value="12,0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TabItem">
                                                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TabControl.ItemContainerStyle>
                                        </TabControl>
                                        <Button x:Name="SplitSourceViewButton" Grid.Column="1" Content="◫" Width="36" Height="38"
                                                MinWidth="36" Padding="0" BorderThickness="0" Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17"
                                                ToolTip="소스 코드 보기 분할" Click="SplitSourceViewButton_Click"/>
                                        <Button x:Name="SourceTabsMoreButton" Grid.Column="2" Content="⋯" Width="36" Height="38"
                                                MinWidth="36" Padding="0" BorderThickness="0" Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18"
                                                ToolTip="소스 탭 메뉴" Click="SourceTabsMoreButton_Click"/>
                                    </Grid>

                                    <!-- 탭 바로 아래에서 곧바로 소스가 시작된다. 분할 버튼은 이 Grid에 열을 계속 추가한다. -->
                                    <Grid x:Name="SourceSplitHost" Grid.Row="1" Background="{DynamicResource CodeSurfaceBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SourceCodeViewer" Grid.Column="0" IsReadOnly="True" IsUndoEnabled="False"
                                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                                 FontFamily="Consolas" FontSize="13"
                                                 Background="{DynamicResource CodeSurfaceBrush}" Foreground="{DynamicResource CodeTextBrush}"
                                                 CaretBrush="{DynamicResource CodeTextBrush}" SelectionBrush="{DynamicResource CodeSelectionBrush}"
                                                 BorderThickness="0" Padding="12,10"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Text="프로젝트 탐색기에서 파일을 한 번 클릭하면 미리보고, 두 번 클릭하면 탭으로 고정합니다."/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== B. XLS 분리 (언어 무관) ===================== -->
            <TabItem x:Name="SectionXlsTab" AutomationProperties.AutomationId="SectionXlsTab"
                     Style="{StaticResource SectionTabItem}" Header="XLS 분리 (모든 언어)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- 실 xls 의 파일명(WndLongSampleAnalyzeControlView.cs 같은)은 310px 에서 이름도 건수도
                                 잘리고 가로 스크롤이 생겼다. 트리 폭을 넉넉히 주고(아래 트리는 가로 스크롤 금지 +
                                 말줄임), 오른쪽 본문은 남는 폭으로도 충분하다. -->
                            <ColumnDefinition Width="440"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 범위 = 팀 분담. 로컬 소스를 스캔하지 않고 XLS 의 검출 경로로 트리를 만든다. -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="작업 범위 (XLS 경로)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="XlsScopeSummary" AutomationProperties.AutomationId="XlsScopeSummary"
                                                   Text="XLS를 선택하면 검출 경로 트리가 만들어집니다." Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SelectAllXlsScopeButton" AutomationProperties.AutomationId="SelectAllXlsScopeButton"
                                            Grid.Column="1" Content="전체" MinWidth="58"
                                            Margin="8,0,0,0" Click="SelectAllXlsScopeButton_Click"/>
                                    <Button x:Name="ClearXlsScopeButton" AutomationProperties.AutomationId="ClearXlsScopeButton"
                                            Grid.Column="2" Content="해제" MinWidth="58"
                                            Margin="6,0,0,0" Click="ClearXlsScopeButton_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,8"
                                           Style="{StaticResource MutedText}"
                                           Text="XLS 가 적어 둔 검출 경로로 만든 트리입니다(로컬 소스를 뒤지지 않습니다). 아무것도 체크하지 않으면 전건을 분리합니다."/>
                                <!-- 공통 접두 캡션: 모든 검출 경로가 공유하는 상위 폴더는 트리에서 빼고 여기 한 줄로 보여 준다
                                     (트리는 실제 분기점부터 시작). 접두가 없으면(경로가 처음부터 분기) 통째로 숨긴다. -->
                                <Border x:Name="XlsScopeCommonPathBox" Grid.Row="2" Visibility="Collapsed"
                                        Background="#F1F4F6" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                                    <TextBlock x:Name="XlsScopeCommonPath" AutomationProperties.AutomationId="XlsScopeCommonPath"
                                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <!-- 가상화 OFF: 노드가 수백 수준이라 성능 문제가 없고, 켜 두면 화면에 보이는 42개만
                                     자동화 트리에 실체화돼 스크린리더·UIA 하네스가 전체를 볼 수 없다.
                                     가로 스크롤 Disabled: 폭을 넘는 이름은 스크롤 대신 말줄임(+ToolTip 전체 경로)한다. -->
                                <TreeView x:Name="XlsScopeTree" AutomationProperties.AutomationId="XlsScopeTree" Grid.Row="3"
                                          ItemsSource="{Binding XlsScopeRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemTemplate="{StaticResource SelectableScopeTemplate}"
                                          ItemContainerStyle="{StaticResource ScopeTreeItemStyle}"
                                          BorderThickness="0" Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="0" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="입력" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Sparrow 결과 XLS" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TrackCXlsPathBox" AutomationProperties.AutomationId="TrackCXlsPathBox"
                                                         Style="{StaticResource InputBox}" IsReadOnly="True"
                                                         TextChanged="TrackCXlsPathBox_TextChanged"/>
                                                <Button x:Name="BrowseTrackCXlsButton" Grid.Column="1" Content="XLS 선택"
                                                        Margin="8,0,0,0" Click="BrowseTrackCXlsButton_Click"/>
                                            </Grid>
                                            <TextBlock Text="입력은 XLS 하나입니다. 프로젝트 경로도, 체커 가이드 같은 선행 문서도 필요하지 않습니다."
                                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="출력" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="출력 폴더 (비우면 XLS 옆 &lt;이름&gt;.export)" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TrackCOutputPathBox" AutomationProperties.AutomationId="TrackCOutputPathBox"
                                                         Style="{StaticResource InputBox}"/>
                                                <Button x:Name="BrowseTrackCOutputButton" Grid.Column="1" Content="폴더 선택"
                                                        Margin="8,0,0,0" Click="BrowseTrackCOutputButton_Click"/>
                                            </Grid>
                                            <TextBlock Text="왼쪽에서 고른 범위(팀 분담)에 해당하는 항목만 md 로 분리됩니다."
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Sparrow 검출 전건을 체커별 폴더로 분리합니다 — &lt;체커 키&gt;\{ID}_{파일명}_{라인}.md 만 생성. (전건 정책 — 심각도/체커 필터 없음)"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <Border Margin="0,14,0,0" Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="0" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="체커 규칙" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TrackCMappingSummary" AutomationProperties.AutomationId="TrackCMappingSummary"
                                                           Text="XLS를 선택하면 검출 체커가 요약됩니다." Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="규칙은 이름 붙인 라이브러리이고, 체커에 규칙을 직접 지정해야 부착됩니다(파일명이 체커키와 같아도 자동 지정 안 함). 규칙 편집·체커 지정은 [체커 규칙 관리] 창에서 합니다."
                                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="OpenRuleManagerButton" AutomationProperties.AutomationId="OpenRuleManagerButton"
                                                    Grid.Column="1" Content="체커 규칙 관리" Style="{StaticResource PrimaryButton}"
                                                    MinWidth="132" VerticalAlignment="Top" Margin="16,2,0,0"
                                                    Click="OpenRuleManagerButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="0" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="이 화면이 하는 일" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Text="XLS → &lt;체커 키&gt; 폴더 + 항목 md(요약/인덱스 파일 없음). 각 md 는 xls 의 항목 정보(파일·라인·경로·체커 설명)와 소스 코드를 그대로 옮겨 담습니다. 지정된 체커에만 규칙이 self-contained 로 부착됩니다."/>
                                            <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="범위 트리는 이 XLS 자신의 경로로 만들어 그대로 되먹이므로, 팀원마다 체크아웃 위치가 달라도 매칭이 어긋나지 않습니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SectionCSharpTab" AutomationProperties.AutomationId="SectionCSharpTab"
                     Style="{StaticResource SectionTabItem}" Header="코드 자동수정 (C#)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 기존 C# 소스 선택 기능. 파일 메뉴와 연결하지 않고 이 탭 안의 버튼으로만 변경한다. -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="대상(.sln/.csproj/폴더)" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="CSharpTargetPathBox" AutomationProperties.AutomationId="CSharpTargetPathBox"
                                 Grid.Column="1" Style="{StaticResource InputBox}"
                                 TextChanged="CSharpTargetPathBox_TextChanged" VerticalAlignment="Center"/>
                        <Button x:Name="CSharpBrowseFileButton" Grid.Column="2" Content="파일 선택" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="CSharpBrowseFileButton"
                                Click="CSharpBrowseFileButton_Click"/>
                        <Button x:Name="CSharpBrowseFolderButton" Grid.Column="3" Content="폴더 선택" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="CSharpBrowseFolderButton"
                                Click="CSharpBrowseFolderButton_Click"/>
                        <Button x:Name="CSharpRefreshScopeButton" Grid.Column="4" Content="새로고침" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="CSharpRefreshScopeButton"
                                Click="CSharpRefreshScopeButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="작업 범위 (로컬 소스)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="CSharpScopeStatusText"
                                                   AutomationProperties.AutomationId="CSharpScopeStatusText"
                                                   Text="대상 경로를 선택하세요." Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="CSharpSelectAllScopeButton" Grid.Column="1" Content="전체" MinWidth="58"
                                            Margin="8,0,0,0" Click="CSharpSelectAllScopeButton_Click"/>
                                    <Button x:Name="CSharpClearScopeButton" Grid.Column="2" Content="해제" MinWidth="58"
                                            Margin="6,0,0,0" Click="CSharpClearScopeButton_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="bin/obj/.git/.vs/packages 및 생성 파일은 기본 제외됩니다."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                                <TreeView x:Name="CSharpScopeTree" AutomationProperties.AutomationId="CSharpScopeTree"
                                          Grid.Row="2"
                                          ItemsSource="{Binding CSharpScopeRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemTemplate="{StaticResource SelectableScopeTemplate}"
                                          ItemContainerStyle="{StaticResource ScopeTreeItemStyle}"
                                          SelectedItemChanged="CSharpScopeTree_SelectedItemChanged"
                                          BorderThickness="0" Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Background="{DynamicResource TitleBarBrush}" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C# 소스 코드 보기" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,10,0"/>
                                    <TextBlock x:Name="CSharpSourcePathText" Grid.Column="1"
                                               Text="작업 범위에서 파일을 선택하세요."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                                <TextBox x:Name="CSharpSourceCodeViewer" Grid.Row="1"
                                         IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                                         Background="{DynamicResource CodeSurfaceBrush}" Foreground="{DynamicResource CodeTextBrush}"
                                         CaretBrush="{DynamicResource CodeTextBrush}" SelectionBrush="{DynamicResource CodeSelectionBrush}"
                                         BorderThickness="0" Padding="12,10"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Text="작업 범위에서 C# 파일을 선택하면 읽기 전용으로 표시합니다."/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 명령은 상단 메뉴, 로그는 우측 상단 문서 아이콘으로 이관. 하단은 상태만 표시한다. -->
        <Border x:Name="StatusBarPanel" Grid.Row="1" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="10,6" Margin="-12,10,-12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="대기 중"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock x:Name="ActiveTaskStatusText" Grid.Column="1" Text="준비됨" Margin="12,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ExecutionProgressBar" Grid.Column="2" Height="8" Margin="12,0"
                             Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"
                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"/>
                <TextBlock x:Name="ProgressStatusText" Grid.Column="3" Text="0%" MinWidth="40"
                           TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>

                <!-- 코드비하인드 명령/로그 버퍼 호환용 숨김 프록시. 화면에는 표시하지 않는다. -->
                <Grid Visibility="Collapsed">
                    <Button x:Name="RunButton" Click="RunButton_Click"/>
                    <Button x:Name="StopButton" Click="StopButton_Click"/>
                    <Button x:Name="OpenTargetButton" Click="OpenTargetButton_Click"/>
                    <Button x:Name="OpenTrackCOutputButton" Click="OpenTrackCOutputButton_Click"/>
                    <CheckBox x:Name="CommitCheck" IsChecked="False"
                              Checked="CommitCheck_Changed" Unchecked="CommitCheck_Changed"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
