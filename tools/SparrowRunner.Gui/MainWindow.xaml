<Window x:Class="SparrowRunner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SparrowRunner.Gui"
        Title="Sparrow Helper"
        Width="1360" Height="860"
        MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0064FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#191F28"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5968"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E5E8EB"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>

        <!-- 상태 색상(매핑=성공/초록, 미매핑=경고/주황). 배지 배경/글자에 사용. -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#0F8A3C"/>
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#E7F6EC"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#B25E00"/>
        <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF2DE"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 비활성이 색으로도 읽혀야 한다. 커스텀 템플릿이라 트리거가 없으면 disabled 가 enabled 와
                 똑같이 보여 "눌러도 아무 일 없는 버튼"이 된다(예: 도구 미탐색 상태의 실행 버튼). -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F4F6"/>
                    <Setter Property="BorderBrush" Value="#E5E8EB"/>
                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RuleCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E8F2FF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 대분류(섹션) 탭은 하위 트랙 탭보다 크게 — 화면이 통째로 바뀌는 전환임을 시각적으로 알린다. -->
        <Style x:Key="SectionTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 범위 트리 한 줄. 로컬 소스 트리(Track A/B)와 xls 경로 트리(Track C)가 같은 노드 타입을 쓴다.
             Label = 이름(+ 검출 건수). AutomationId/Name 은 UIA 하네스가 노드를 이름으로 찾아 토글하기 위한 것. -->
        <HierarchicalDataTemplate DataType="{x:Type local:SourceScopeNode}" ItemsSource="{Binding Children}">
            <CheckBox IsThreeState="{Binding HasChildren}"
                      AutomationProperties.AutomationId="scopeNodeCheck"
                      AutomationProperties.Name="{Binding Name}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Checked="ScopeCheckBox_Changed"
                      Unchecked="ScopeCheckBox_Changed"
                      Indeterminate="ScopeCheckBox_Changed"
                      Margin="0,2,0,2">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <!-- XLS 범위 트리 전용 항목 스타일(로컬 소스 트리는 위 기본 스타일 그대로 둔다).
             * AutomationProperties.Name: 명시하지 않으면 TreeViewItem 의 UIA 이름이 ToString() 폴백
               (= "SparrowRunner.Gui.SourceScopeNode") 으로 노출돼 스크린리더도 자동화도 노드를 못 읽는다.
               노드 표시명(이름 + 건수)을 그대로 이름으로 준다.
             * ToolTip: 실 규모에서는 이름이 길어 말줄임되므로 전체 경로(폴더=접두 경로, 파일=xls 원본 경로)를 띄운다.
             * HorizontalContentAlignment=Stretch: 행이 패널 폭을 채워야 TextTrimming 이 동작한다(가로 스크롤 대신 말줄임). -->
        <!-- 범위 트리(로컬 소스·XLS 경로 공용) 노드 스타일. AutomationProperties.Name 을 명시하지 않으면
             WPF 가 데이터 객체의 ToString() 으로 폴백해 UIA/스크린리더에 "SparrowRunner.Gui.SourceScopeNode"
             로 노출된다(실 xls 규모에서 발견). 두 트리 모두 SourceScopeNode 를 쓰므로 스타일을 공유한다. -->
        <Style x:Key="ScopeTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 마스터 목록(체커) 항목: 상용 설정앱풍 선택/호버 하이라이트. AutomationProperties.Name={Key} 로
             UIA 가 SelectionItemPattern 으로 행을 골라 선택할 수 있게 한다. -->
        <Style x:Key="MappingItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Key}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Sparrow Helper" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SectionHintText" AutomationProperties.AutomationId="SectionHintText"
                       Text="무엇을 할지 위에서 고르세요. 화면이 통째로 바뀝니다."
                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ===================== 대분류 2개 ===================== -->
        <!-- A. 코드 자동수정(내부 Track A/B) : C# 전용 · 소스 파일을 고친다(파괴적). 커밋은 하지 않는다 —
                러너에 항상 -NoCommit 을 넘기고, 검토·커밋은 사용자가 git 으로 한다.
             B. XLS 분리(내부 Track C)       : 언어 무관 · 프로젝트 경로 불필요 · 읽기전용.
             둘은 입력도 위험도도 다르므로 같은 화면에 섞지 않는다.
             화면 명칭 ↔ 내부 트랙: [코드 규칙]=A · [주석·레이아웃]=B · [XLS 분리]=C (UI 에는 트랙 명칭을 쓰지 않는다). -->
        <TabControl x:Name="SectionTabs" AutomationProperties.AutomationId="SectionTabs"
                    Grid.Row="1" BorderThickness="0" Background="Transparent"
                    SelectionChanged="SectionTabs_SelectionChanged">

            <!-- ===================== A. 코드 자동수정 (C# 전용) ===================== -->
            <TabItem x:Name="SectionFixTab" AutomationProperties.AutomationId="SectionFixTab"
                     Style="{StaticResource SectionTabItem}" Header="코드 자동수정 (C#)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource WarnBgBrush}" BorderBrush="#F2D4A6"
                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12">
                            <Run FontWeight="SemiBold" Text="C# 전용 · 소스 파일을 실제로 수정합니다(커밋은 하지 않습니다)."/>
                            <Run Text="Roslyn C# 파서로 코드를 재작성하므로 C/C++ 등 다른 언어에는 쓸 수 없습니다. C/C++ 결과는 위의 [XLS 분리] 대분류를 사용하세요. 실행 후에는 git diff 로 변경을 검토한 뒤 직접 커밋하세요."/>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="대상(.sln/.csproj/폴더)" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="TargetPathBox" AutomationProperties.AutomationId="TargetPathBox"
                                 Grid.Column="1" Style="{StaticResource InputBox}" TextChanged="TargetPathBox_TextChanged"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="BrowseFileButton" Grid.Column="2" Content="파일 선택" Margin="8,0,0,0" Click="BrowseFileButton_Click"/>
                        <Button x:Name="BrowseFolderButton" Grid.Column="3" Content="폴더 선택" Margin="8,0,0,0" Click="BrowseFolderButton_Click"/>
                        <Button x:Name="RefreshScopeButton" Grid.Column="4" Content="새로고침" Margin="8,0,0,0" Click="RefreshScopeButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="작업 범위 (로컬 소스)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="ScopeStatusText" AutomationProperties.AutomationId="ScopeStatusText"
                                                   Text="대상 경로를 선택하세요." Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SelectAllScopeButton" Grid.Column="1" Content="전체" MinWidth="58"
                                            Margin="8,0,0,0" Click="SelectAllScopeButton_Click"/>
                                    <Button x:Name="ClearScopeButton" Grid.Column="2" Content="해제" MinWidth="58"
                                            Margin="6,0,0,0" Click="ClearScopeButton_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="bin/obj/.git/.vs/packages 및 생성 파일은 기본 제외됩니다."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                                <TreeView x:Name="ScopeTree" AutomationProperties.AutomationId="ScopeTree" Grid.Row="2"
                                          ItemsSource="{Binding ScopeRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemContainerStyle="{StaticResource ScopeTreeItemStyle}"
                                          BorderThickness="0" Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="210"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14">
                                <TabControl x:Name="RulesTabs" AutomationProperties.AutomationId="RulesTabs"
                                            BorderThickness="0" Background="Transparent" SelectionChanged="RulesTabs_SelectionChanged">
                                    <TabItem x:Name="TrackATab" AutomationProperties.AutomationId="TrackATab" Header="코드 규칙">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="기본 자동수정" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="ASObjectVarSafe" Content="객체 생성 명시 타입을 var로 변경" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObviousVar" Content="명확한 지역변수 타입을 var로 변경" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASArrayVarSafe" Content="배열 초기화 문법 간소화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASParens" Content="논리식 괄호 명확화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                                <TextBlock Text="선택 자동수정" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="ASForeachCast" Content="[검토필요] foreach Cast&lt;T&gt; + var" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObjectInitializer" Content="연속 대입을 object initializer로 통합" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASNullVar" Content="[검토필요] typed null var 초기화" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASObjectVarNarrowing" Content="[검토필요] 상위 타입 선언을 var로 축소" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASLocalConst" Content="[검토필요] 지역 const를 var로 변경" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASArrayVarNarrowing" Content="[검토필요] 배열 선언을 var + new[]로 축소" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASForVar" Content="for 초기화절 변수를 var로 변경" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASFieldSplit" Content="한 줄 다중 필드 선언 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASEmptyStmt" Content="잉여 빈문장 제거" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="ASForHoist" Content="[검토필요] for 다중 선언자 hoist 분해" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem x:Name="TrackBTab" AutomationProperties.AutomationId="TrackBTab" Header="주석·레이아웃">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="기본 주석 규칙" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="BTrailing" Content="코드 뒤 주석을 윗줄로 이동" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BSpace" Content="주석 기호 뒤 공백 추가" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BPeriod" Content="주석 끝 마침표 추가" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BCapitalize" Content="주석 첫 영문 대문자화" IsChecked="True" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                                <TextBlock Text="선택 레이아웃/주석 규칙" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <CheckBox x:Name="BFlatten" Content="별표/Doxygen 블록 주석 평탄화" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BMemberBlank" Content="멤버 선언 사이 빈 줄 추가" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BOneDeclaration" Content="한 줄 다중 선언 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BOneStatement" Content="한 줄 다중 구문 분리" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BContinuation" Content="여러 줄 문장 들여쓰기 보정" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BLinqAlign" Content="LINQ query 절 정렬" Style="{StaticResource RuleCheck}"/>
                                                    <CheckBox x:Name="BBlockPromote" Content="[검토필요] inline block 주석 이동" Style="{StaticResource RuleCheck}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                </TabControl>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="RuleInfoTitle" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="RuleInfoBody" Margin="0,4,0,8" Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="260" Margin="16,0,0,0">
                                            <TextBlock x:Name="SummaryTargetText" Text="대상 경로가 필요합니다."
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SummaryRulesText" Text="선택 규칙 0개"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="SummaryModeText" Text="파일만 수정 · 커밋하지 않음"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Before" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="RuleBeforeBox" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False"
                                                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap" Background="#0B1220" Foreground="#E5E7EB"
                                                     BorderBrush="#253044" Padding="10"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="After" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox x:Name="RuleAfterBox" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False"
                                                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap" Background="#F8FAFF" Foreground="#191F28"
                                                     BorderBrush="#C9DDFF" Padding="10"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== B. XLS 분리 (언어 무관) ===================== -->
            <TabItem x:Name="SectionXlsTab" AutomationProperties.AutomationId="SectionXlsTab"
                     Style="{StaticResource SectionTabItem}" Header="XLS 분리 (모든 언어)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SuccessBgBrush}" BorderBrush="#BFE3CB"
                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" FontSize="12">
                            <Run FontWeight="SemiBold" Text="언어 무관 · 프로젝트 경로 불필요 · 소스를 수정하지 않습니다(읽기전용)."/>
                            <Run Text="입력은 Sparrow 결과 XLS 하나뿐입니다. C/C++/C#/Java 등 어떤 언어의 검출이든 체커별 폴더의 md 로 분리합니다."/>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- 실 xls 의 파일명(WndLongSampleAnalyzeControlView.cs 같은)은 310px 에서 이름도 건수도
                                 잘리고 가로 스크롤이 생겼다. 트리 폭을 넉넉히 주고(아래 트리는 가로 스크롤 금지 +
                                 말줄임), 오른쪽 본문은 남는 폭으로도 충분하다. -->
                            <ColumnDefinition Width="440"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 범위 = 팀 분담. 로컬 소스를 스캔하지 않고 XLS 의 검출 경로로 트리를 만든다. -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="작업 범위 (XLS 경로)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="XlsScopeSummary" AutomationProperties.AutomationId="XlsScopeSummary"
                                                   Text="XLS를 선택하면 검출 경로 트리가 만들어집니다." Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SelectAllXlsScopeButton" AutomationProperties.AutomationId="SelectAllXlsScopeButton"
                                            Grid.Column="1" Content="전체" MinWidth="58"
                                            Margin="8,0,0,0" Click="SelectAllXlsScopeButton_Click"/>
                                    <Button x:Name="ClearXlsScopeButton" AutomationProperties.AutomationId="ClearXlsScopeButton"
                                            Grid.Column="2" Content="해제" MinWidth="58"
                                            Margin="6,0,0,0" Click="ClearXlsScopeButton_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,8"
                                           Style="{StaticResource MutedText}"
                                           Text="XLS 가 적어 둔 검출 경로로 만든 트리입니다(로컬 소스를 뒤지지 않습니다). 아무것도 체크하지 않으면 전건을 분리합니다."/>
                                <!-- 공통 접두 캡션: 모든 검출 경로가 공유하는 상위 폴더는 트리에서 빼고 여기 한 줄로 보여 준다
                                     (트리는 실제 분기점부터 시작). 접두가 없으면(경로가 처음부터 분기) 통째로 숨긴다. -->
                                <Border x:Name="XlsScopeCommonPathBox" Grid.Row="2" Visibility="Collapsed"
                                        Background="#F1F4F6" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                                    <TextBlock x:Name="XlsScopeCommonPath" AutomationProperties.AutomationId="XlsScopeCommonPath"
                                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <!-- 가상화 OFF: 노드가 수백 수준이라 성능 문제가 없고, 켜 두면 화면에 보이는 42개만
                                     자동화 트리에 실체화돼 스크린리더·UIA 하네스가 전체를 볼 수 없다.
                                     가로 스크롤 Disabled: 폭을 넘는 이름은 스크롤 대신 말줄임(+ToolTip 전체 경로)한다. -->
                                <TreeView x:Name="XlsScopeTree" AutomationProperties.AutomationId="XlsScopeTree" Grid.Row="3"
                                          ItemsSource="{Binding XlsScopeRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemContainerStyle="{StaticResource ScopeTreeItemStyle}"
                                          BorderThickness="0" Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="입력" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Sparrow 결과 XLS" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TrackCXlsPathBox" AutomationProperties.AutomationId="TrackCXlsPathBox"
                                                         Style="{StaticResource InputBox}" IsReadOnly="True"
                                                         TextChanged="TrackCXlsPathBox_TextChanged"/>
                                                <Button x:Name="BrowseTrackCXlsButton" Grid.Column="1" Content="XLS 선택"
                                                        Margin="8,0,0,0" Click="BrowseTrackCXlsButton_Click"/>
                                            </Grid>
                                            <TextBlock Text="입력은 XLS 하나입니다. 프로젝트 경로도, 체커 가이드 같은 선행 문서도 필요하지 않습니다."
                                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="출력" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="출력 폴더 (비우면 XLS 옆 &lt;이름&gt;.export)" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TrackCOutputPathBox" AutomationProperties.AutomationId="TrackCOutputPathBox"
                                                         Style="{StaticResource InputBox}"/>
                                                <Button x:Name="BrowseTrackCOutputButton" Grid.Column="1" Content="폴더 선택"
                                                        Margin="8,0,0,0" Click="BrowseTrackCOutputButton_Click"/>
                                            </Grid>
                                            <TextBlock Text="왼쪽에서 고른 범위(팀 분담)에 해당하는 항목만 md 로 분리됩니다."
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Sparrow 검출 전건을 체커별 폴더로 분리합니다 — &lt;체커 키&gt;\{ID}_{파일명}_{라인}.md 만 생성. (전건 정책 — 심각도/체커 필터 없음)"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <Border Margin="0,14,0,0" Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="체커 규칙" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TrackCMappingSummary" AutomationProperties.AutomationId="TrackCMappingSummary"
                                                           Text="XLS를 선택하면 검출 체커가 요약됩니다." Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="규칙은 이름 붙인 라이브러리이고, 체커에 규칙을 직접 지정해야 부착됩니다(파일명이 체커키와 같아도 자동 지정 안 함). 규칙 편집·체커 지정은 [체커 규칙 관리] 창에서 합니다."
                                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="OpenRuleManagerButton" AutomationProperties.AutomationId="OpenRuleManagerButton"
                                                    Grid.Column="1" Content="체커 규칙 관리" Style="{StaticResource PrimaryButton}"
                                                    MinWidth="132" VerticalAlignment="Top" Margin="16,2,0,0"
                                                    Click="OpenRuleManagerButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="이 화면이 하는 일" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Text="XLS → &lt;체커 키&gt; 폴더 + 항목 md(요약/인덱스 파일 없음). 각 md 는 xls 의 항목 정보(파일·라인·경로·체커 설명)와 소스 코드를 그대로 옮겨 담습니다. 지정된 체커에만 규칙이 self-contained 로 부착됩니다."/>
                                            <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="범위 트리는 이 XLS 자신의 경로로 만들어 그대로 되먹이므로, 팀원마다 체크아웃 위치가 달라도 매칭이 어긋나지 않습니다."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 실행/로그는 두 대분류가 공유한다. 실행 버튼은 항상 '지금 선택된 대분류의 트랙'만 돌린다. -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunButton" AutomationProperties.AutomationId="RunButton"
                            Content="실행" Style="{StaticResource PrimaryButton}" Click="RunButton_Click"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="중지" Margin="8,0,0,0"
                            Click="StopButton_Click" IsEnabled="False"/>
                    <Button x:Name="OpenTargetButton" Grid.Column="2" Content="대상 폴더 열기" Margin="8,0,0,0"
                            Click="OpenTargetButton_Click"/>
                    <Button x:Name="OpenTrackCOutputButton" Grid.Column="3" Content="XLS 분리 출력 열기" Margin="8,0,0,0"
                            Click="OpenTrackCOutputButton_Click" IsEnabled="False"/>
                    <Button x:Name="ClearLogButton" Grid.Column="4" Content="로그 지우기" Margin="8,0,0,0"
                            Click="ClearLogButton_Click"/>
                    <!-- 규칙별 커밋: 켜면 러너가 규칙 하나를 적용할 때마다 커밋을 만든다(롤백 단위 = 규칙).
                         끄면 파일만 고치고 커밋은 사용자가 git 으로 한다(-NoCommit). [코드 규칙]/[주석·레이아웃] 전용 —
                         [XLS 분리]는 소스를 건드리지 않으므로 숨긴다. -->
                    <CheckBox x:Name="CommitCheck" AutomationProperties.AutomationId="CommitCheck"
                              Grid.Column="5" Content="규칙별 커밋 생성" IsChecked="False"
                              Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="CommitCheck_Changed" Unchecked="CommitCheck_Changed"
                              ToolTip="켜면 규칙마다 커밋을 만들어 규칙 단위로 되돌릴 수 있습니다. 끄면 파일만 수정하고 커밋은 직접 하십시오."/>
                    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Column="6" Text="대기 중"
                               VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                </Grid>
                <Expander Grid.Row="1" Header="실행 로그" Margin="0,10,0,0" IsExpanded="False">
                    <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="160"
                             IsReadOnly="True" IsUndoEnabled="False"
                             FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="#111827" Foreground="#D1D5DB"
                             BorderThickness="0" Padding="12"/>
                </Expander>
            </Grid>
        </Border>
    </Grid>
</Window>
