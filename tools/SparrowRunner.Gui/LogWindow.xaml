<Window x:Class="SparrowRunner.Gui.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sparrow Helper 실행 로그" Width="900" Height="600" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#181A20"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="HeaderBorder" Background="#20232B" BorderBrush="#343842" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <TextBlock Text="실행 로그" FontSize="17" FontWeight="SemiBold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                <TextBlock Text="세션 동안 실시간으로 갱신됩니다." Foreground="#8B95A1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False"
                 FontFamily="Consolas" FontSize="12" Padding="16" BorderThickness="0"
                 Background="#111318" Foreground="#D1D7E0" CaretBrush="#D1D7E0"
                 VerticalContentAlignment="Top" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
