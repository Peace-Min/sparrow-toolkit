<Window x:Class="SparrowRunner.Gui.RuleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SparrowRunner.Gui"
        Title="체커 규칙 관리"
        Width="1000" Height="740"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FA"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0064FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#191F28"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5968"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E5E8EB"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0F8A3C"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#B25E00"/>

        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- 파괴적 액션(삭제)은 생성/저장 버튼과 색·위치를 모두 분리한다(실수 클릭 방지). -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#C13515"/>
            <Setter Property="BorderBrush" Value="#F0C4B8"/>
            <Setter Property="Height" Value="28"/>
            <!-- 이 창의 Button 템플릿은 Padding 을 쓰지 않으므로 여백은 MinWidth 로 확보한다(글자 붙어 보이는 것 방지). -->
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="RuleItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 체커 매핑 한 행: 체커 키 + 건수 + 규칙 선택 ComboBox("— 없음 —" + 라이브러리 규칙들). -->
        <DataTemplate DataType="{x:Type local:CheckerAssignmentRow}">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock AutomationProperties.AutomationId="assignCheckerKey"
                               AutomationProperties.Name="{Binding Key}"
                               Text="{Binding Key}" ToolTip="{Binding Key}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <ComboBox Grid.Column="2" AutomationProperties.AutomationId="assignCombo"
                              AutomationProperties.Name="{Binding Key}"
                              ItemsSource="{Binding AvailableRules}"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              Height="30" VerticalContentAlignment="Center">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="체커 규칙 관리" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="규칙은 이름 붙인 라이브러리입니다. 검출 체커에 규칙을 직접 지정해야 부착되며, 파일명이 체커 키와 같아도 자동으로 지정되지 않습니다. 지정은 기억되어 다음에 같은 체커가 나오면 미리 채워집니다."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== A. 규칙 라이브러리 (xls 무관) ===== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="규칙 라이브러리" Style="{StaticResource SectionTitle}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RuleNewButton" AutomationProperties.AutomationId="RuleNewButton"
                                Content="새 규칙" Click="RuleNewButton_Click"/>
                        <TextBlock Grid.Column="1" Text="고르면 아래에서 편집"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="RuleEmptyText" Text="규칙이 없습니다. [새 규칙]으로 추가하세요."
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="12" VerticalAlignment="Top"/>
                            <ListBox x:Name="RuleList" AutomationProperties.AutomationId="RuleList"
                                     ItemContainerStyle="{StaticResource RuleItemStyle}"
                                     SelectionChanged="RuleList_SelectionChanged"
                                     BorderThickness="0" Background="Transparent" Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 파괴적 액션은 목록 바로 아래 우측에 따로 둔다([새 규칙] 옆에 두면 실수 클릭이 난다). -->
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Button x:Name="RuleDeleteButton" AutomationProperties.AutomationId="RuleDeleteButton"
                                Style="{StaticResource DangerButton}" Content="선택 규칙 삭제"
                                HorizontalAlignment="Right" Click="RuleDeleteButton_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="규칙 이름" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
                    <TextBox x:Name="RuleNameBox" AutomationProperties.AutomationId="RuleNameBox" Grid.Row="5"
                             Style="{StaticResource InputBox}"/>

                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <TextBox x:Name="RuleEditor" AutomationProperties.AutomationId="RuleEditor"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                 Padding="10" Background="#FFFFFF" BorderBrush="#D1D6DB"
                                 VerticalContentAlignment="Top"/>
                        <TextBlock IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="13" FontFamily="Consolas" Margin="12,10,12,0"
                                   VerticalAlignment="Top" TextWrapping="Wrap"
                                   Text="규칙 내용을 입력하세요. 저장하면 references\checkers\&lt;이름&gt;.md 로 기록됩니다."
                                   Visibility="{Binding Text, ElementName=RuleEditor, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                    <Grid Grid.Row="7" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RuleSaveButton" AutomationProperties.AutomationId="RuleSaveButton"
                                Style="{StaticResource PrimaryButton}" Content="규칙 저장" MinWidth="96"
                                Click="RuleSaveButton_Click"/>
                        <TextBlock x:Name="RuleStatusText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== B. 체커 매핑 (xls 검출 체커) ===== -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="체커 매핑" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AssignStatusText" AutomationProperties.AutomationId="AssignStatusText"
                                   Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="각 검출 체커에 라이브러리 규칙을 지정하세요. 미지정('— 없음 —')은 순수 출력입니다. 미지정 체커가 위에 정렬됩니다."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Border Grid.Row="2" Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="AssignEmptyText" AutomationProperties.AutomationId="AssignEmptyText"
                                       Text="검출된 체커가 없습니다. 메인 화면에서 XLS를 선택하면 여기에 표시됩니다."
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="12" VerticalAlignment="Top"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                <ItemsControl x:Name="AssignList" AutomationProperties.AutomationId="AssignList"
                                              ItemsSource="{Binding AssignRows, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AssignSaveButton" AutomationProperties.AutomationId="AssignSaveButton"
                                Style="{StaticResource PrimaryButton}" Content="지정 저장" MinWidth="96"
                                Click="AssignSaveButton_Click"/>
                        <TextBlock x:Name="AssignSavedText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="CloseButton" Grid.Column="1" Content="닫기" HorizontalAlignment="Right"
                                Margin="0,0,12,0" Click="CloseButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
